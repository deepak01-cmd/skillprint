    "@fontsource-variable/lexend": "5.2.8",
    "bcryptjs": "2.4.3",
    "embedded-postgres": "16.14.0-beta.17",
    "exceljs": "^4.4.0",
    "jose": "5.9.6",
    "jszip": "^3.10.2",
    "lucide-react": "0.460.0",
